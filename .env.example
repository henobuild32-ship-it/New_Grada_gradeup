# ============================================================
# GradeUp — Variables d'environnement (exemple)
# Copier en `.env` et renseigner les valeurs réelles.
# NEVER committer le vrai `.env` (il contient des secrets).
# ============================================================

# --- URL publique ---
NEXT_PUBLIC_APP_URL="https://gradeup-trho.vercel.app"

# --- Base de données PostgreSQL (Prisma) ---
DB_HOST="pg6001.site4now.net"
DB_PORT="6432"
DB_NAME="db_acfa94_henobuid"
DB_USER="acfa94_henobuid"
DB_PASSWORD="YOUR_DATABASE_PASSWORD"
DB_SSLMODE="require"
# Encodez le mot de passe dans l'URL (par ex. @ devient %40).
DATABASE_URL="postgresql://acfa94_henobuid:YOUR_URL_ENCODED_PASSWORD@pg6001.site4now.net:6432/db_acfa94_henobuid?sslmode=require"
# Connexion utilisée par les migrations Prisma (même serveur Site4Now).
DIRECT_URL="postgresql://acfa94_henobuid:YOUR_URL_ENCODED_PASSWORD@pg6001.site4now.net:6432/db_acfa94_henobuid?sslmode=require"
# --- Auth JWT (sessions en cookie HTTP-only) ---
# IMPORTANT : utiliser des secrets longs et aléatoires en production.
# (fallback dev uniquement — obligatoires si NODE_ENV=production)
JWT_SECRET="change-me-with-a-long-random-string-access"
JWT_REFRESH_SECRET="change-me-with-a-long-random-string-refresh"

# --- Admin ---
# Clé opérations admin (header x-admin-secret pour /api/admin/db-health).
ADMIN_OPS_KEY="change-me-with-a-long-random-admin-key"

# --- Paiements (carte élève) ---
STUDENT_CARD_PRICE_CDF="10000"

# --- Supabase (Realtime + Storage) ---
NEXT_PUBLIC_SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="YOUR-ANON-KEY"
# Clé service_role (côté serveur uniquement, jamais exposée au client)
SUPABASE_SERVICE_ROLE_KEY="YOUR-SERVICE-ROLE-KEY"
# Nom du bucket Storage pour les fichiers (cours, devoirs, ressources, logos)
SUPABASE_STORAGE_BUCKET="Gradeup"

# --- IA Gradie ---
# Fournisseur : auto | local | deepseek | openrouter | glm
# GLM (recommandé)
GLM_API_KEY="YOUR-GLM-API-KEY"
GLM_MODEL="glm-4.5-flash"
# OpenRouter (optionnel)
OR_API_KEY="YOUR-OPENROUTER-KEY"
OR_MODEL="deepseek/deepseek-chat-v3-0324:free"
# DeepSeek (optionnel)
DEEPSEEK_API_KEY="YOUR-DEEPSEEK-KEY"

# --- Notifications Push (Web Push / PWA) ---
# Générer une paire VAPID (web-push generate-vapid-keys)
NEXT_PUBLIC_VAPID_PUBLIC_KEY="YOUR-VAPID-PUBLIC-KEY"
VAPID_PRIVATE_KEY="YOUR-VAPID-PRIVATE-KEY"
VAPID_SUBJECT="mailto:admin@example.com"

# --- Paiements (GeniusPay) ---
GENIUSPAY_API_BASE_URL="https://geniuspay.ci/api/v1/merchant"
GENIUSPAY_API_KEY="pk_live_or_sandbox_placeholder"
GENIUSPAY_API_SECRET="sk_live_or_sandbox_placeholder"

# --- Email (Nodemailer / SMTP) — utilisé pour l'OTP mot de passe oublié ---
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_SECURE="false"          # true si port 465
SMTP_USER="your-smtp-user"
SMTP_PASS="your-smtp-password"
SMTP_FROM="no-reply@example.com"
SMTP_REJECT_UNAUTHORIZED="false"

