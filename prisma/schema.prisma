model Period {
  id          String   @id @default(cuid())
  schoolId    String
  name        String
  code        String
  trimester   Int      @default(1)
  semester    Int?
  startDate   String
  endDate     String
  status      String   @default("OPEN")
  isLocked    Boolean  @default(false)
  schoolYearId String  @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([schoolId, code])
  @@index([schoolId, status])
}

model Fee {
  id        String   @id @default(cuid())
  schoolId  String
  classId   String?
  name      String
  amount    Float
  currency  String   @default("USD")
  dueDate   String   @default("")
  cycle     String   @default("ALL")
  isAnnual  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  school       School         @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  installments Installment[]

  @@index([schoolId, classId])
}

model Installment {
  id         String   @id @default(cuid())
  schoolId   String
  feeId      String?
  studentId  String
  label      String
  amount     Float
  currency   String   @default("USD")
  dueDate    String
  status     String   @default("PENDING")
  paidAt     DateTime?
  paymentId  String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  deletedAt  DateTime?

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  fee    Fee?   @relation(fields: [feeId], references: [id], onDelete: SetNull)

  @@index([schoolId, studentId, status])
  @@index([feeId])
}

model AbsenceJustification {
  id            String   @id @default(cuid())
  schoolId      String
  attendanceId  String?
  studentId     String
  explainedById String
  reason        String
  documentUrl   String   @default("")
  status        String   @default("PENDING")
  reviewedById  String?
  reviewedAt    DateTime?
  reviewNote    String   @default("")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  deletedAt     DateTime?

  school      School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  explainer   User   @relation("JustificationExplainer", fields: [explainedById], references: [id], onDelete: Cascade)
  reviewer    User?  @relation("JustificationReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([schoolId, status])
  @@index([studentId, createdAt])
}

model AuditLog {
  id        String   @id @default(cuid())
  schoolId  String
  userId    String
  action    String
  entity    String
  entityId  String   @default("")
  before    Json?
  after     Json?
  ip        String   @default("")
  userAgent String   @default("")
  createdAt DateTime @default(now())

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([schoolId, entity, entityId])
  @@index([schoolId, userId, createdAt])
  @@index([schoolId, action])
}

// Atomic, cross-instance attempt windows for public school/student code checks.
model RateLimitBucket {
  key       String   @id
  count     Int      @default(0)
  resetAt   DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([resetAt])
}

model GradeSnapshot {
  id          String   @id @default(cuid())
  schoolId    String
  studentId   String
  courseId    String
  period      String   @default("")
  trimester   String   @default("1")
  score       Float
  maxScore    Float    @default(20)
  coefficient Int      @default(1)
  sourceGradeId String  @default("")
  capturedAt  DateTime @default(now())
  createdAt   DateTime @default(now())

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student User  @relation(fields: [studentId], references: [id], onDelete: Cascade)

