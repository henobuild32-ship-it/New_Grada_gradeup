model Bulletin {
  id                     String         @id @default(cuid())
  studentId              String
  classId                String
  schoolId               String
  term                   Int
  academicYear           String
  average                Float          @default(0)
  rank                   Int?
  mention                String         @default("")
  appreciation           String         @default("")
  gradesSnapshot         Json
  attendanceSummary      Json           @default("{}")
  status                 BulletinStatus @default(DRAFT)
  validatedByTitulaireId String?
  validatedByAdminId     String?
  validatedAt            DateTime?
  publishedAt            DateTime?
  version                Int             @default(1)
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt
  deletedAt              DateTime?

  student              User        @relation("BulletinStudent", fields: [studentId], references: [id], onDelete: Cascade)
  class                SchoolClass @relation(fields: [classId], references: [id], onDelete: Cascade)
  school               School      @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  validatedByTitulaire User?       @relation("BulletinTitulaireValidator", fields: [validatedByTitulaireId], references: [id], onDelete: SetNull)
  validatedByAdmin     User?       @relation("BulletinAdminValidator", fields: [validatedByAdminId], references: [id], onDelete: SetNull)

  @@unique([studentId, term, academicYear])
  @@index([schoolId, classId, status])
  @@index([classId, term, academicYear])
  @@index([studentId])
}

enum Gender {
  M
  F
}

enum BulletinStatus {
  DRAFT
  PENDING_TITULAIRE
  VALIDATED_TITULAIRE
  PENDING_ADMIN
  VALIDATED_ADMIN
  PUBLISHED
}

model SubjectRule {
